# Copy this file to .env and fill in real values.

ENVIRONMENT=development
# Setting ENVIRONMENT=production turns on startup guardrails (app/main.py:
# _validate_production_config) that refuse to boot with an insecure
# default — a placeholder SECRET_KEY, SQLite, a dev CORS origin, or the
# in-memory cache backend. Don't set this until the values below are real.

# Default is SQLite — zero setup needed to run locally or for a judge's
# clean clone. Swap for a Postgres URL in production
# (postgresql+psycopg2://user:pass@host:5432/dbname), then run
# `alembic upgrade head` as a deploy step — see docs/DEPLOYMENT.md.
DATABASE_URL=sqlite:///./pulse.db

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Optional — without this, the digest falls back to a deterministic,
# still-correct plain-text summary instead of the AI narrative.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# "memory" works for a single backend process (dev/demo). Once you run
# more than one instance (any real production deploy), set this to
# "redis" and point REDIS_URL at a real Redis — see app/services/cache.py.
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

POLL_INTERVAL_SECONDS=45
SIGNIFICANCE_Z_THRESHOLD=1.5
MIN_HISTORY_POINTS=8
STALENESS_SECONDS=90

# Comma-handled as a Python list by pydantic-settings; set explicitly in
# production to your real frontend origin(s) — never leave the dev
# localhost origins in a production CORS_ORIGINS list.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DEFAULT=120/minute

# Email — leave unset to have password-reset/alert emails logged instead
# of sent (fine for dev; not fine for production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pulse <noreply@pulse.app>
SMTP_USE_TLS=true

# Optional error tracking (Sentry). Unset = disabled.
SENTRY_DSN=

# "auto" = yfinance + NSE fallback (free, unofficial, dev/demo only) or
# "groww" = Groww's own Trading API (needs an account + subscription) —
# see app/services/market_data/README.md.
MARKET_DATA_PROVIDER=auto
GROWW_API_KEY=
GROWW_API_SECRET=

FRONTEND_URL=http://localhost:5173
